# Environment configuration for the plugin-user-management dev Tiltfile
# (dev/Tiltfile).
#
# Copy this file to dev/.env and adjust as needed:
#   cp dev/.env.example dev/.env

# -- OpenEverest core --------------------------------------------------------

# Install the released OpenEverest v2 core (server + controller + CRDs) from
# the published Helm repository. Set to false if you run the core from source
# in a separate Tilt instance.
INSTALL_OPENEVEREST=true

# OpenEverest core chart version, e.g. 2.0.0-dev.4. Leave empty for the latest
# release, pre-releases included.
OPENEVEREST_VERSION=

# Helm repository that hosts the OpenEverest core chart.
OPENEVEREST_HELM_REPO=https://openeverest.github.io/helm-charts/

# Namespace of the core, the plugin and the providers.
EVEREST_NAMESPACE=everest-system

# Initial admin password for the Everest UI/API.
UI_ADMIN_PASSWORD=admin

# -- Plugin ------------------------------------------------------------------

# Command that builds the ESM frontend bundle into dist/main.js.
FRONTEND_BUILD_CMD=[ -d node_modules ] || npm ci; npm run build

# Override the Everest API URL the backend authorizes against. Leave empty to
# use the chart default (discovered in-cluster).
EVEREST_API_URL=

# -- Database providers (all opt-in) -----------------------------------------
# The plugin only manages users on instances of an installed provider. Each
# chart bundles its operator. <NAME>_VERSION empty means the latest chart.

# Percona Server for MongoDB (users).
INSTALL_PSMDB=false
PSMDB_VERSION=

# CloudNativePG (users and databases).
INSTALL_CNPG=false
CNPG_VERSION=

# Percona Operator for PostgreSQL (users and databases).
INSTALL_PERCONA_PG=false
PERCONA_PG_VERSION=

# Microsoft SQL Server (users, databases and roles). The chart and images are
# in Solanica's private registry: set a GitHub username and a token with
# read:packages that can read solanicaio packages. Tilt logs Helm in and
# creates an image pull secret. The operator runs without admission webhooks.
INSTALL_PROVIDER_MSSQL=false
PROVIDER_MSSQL_VERSION=
REGISTRY_SERVER=ghcr.io
REGISTRY_USERNAME=
REGISTRY_PASSWORD=
MSSQL_PULL_SECRET_NAME=solanica-registry

# -- Cluster / registry (optional) -------------------------------------------

# Restrict Tilt to a specific Kubernetes context (recommended).
# K8S_CONTEXT=k3d-plugin-user-management-test

# Push images to a specific registry (defaults to the cluster's local registry).
# DOCKER_REGISTRY_URL=
